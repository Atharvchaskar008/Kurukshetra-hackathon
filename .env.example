# ==============================================================================
# SupplyGuard Environment Configuration
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development
APP_NAME=SupplyGuard
DEBUG=true

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Security & API Authentication
SECRET_KEY=change-this-to-a-secure-random-secret-key
API_KEY=

# LLM & AI Analysis Integrations
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Vulnerability & Threat Intelligence Data Feeds
GITHUB_TOKEN=
NVD_API_KEY=
OSV_API_URL=https://api.osv.dev/v1

# Database & Cache (Optional / Production)
DATABASE_URL=sqlite:///./supplyguard.db
REDIS_URL=redis://localhost:6379/0
